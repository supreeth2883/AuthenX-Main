# AuthenX Environment Configuration Template
# Copy this file to .env and configure for your environment
# IMPORTANT: Never commit the actual .env file to version control!

# ============================================================================
# AuthenX Main Server Configuration
# ============================================================================

# Server Port
PORT=3000

# JWT Secret (REQUIRED in production)
# Generate with: openssl rand -hex 32
# WARNING: Changing this invalidates all existing JWTs
JWT_SECRET=your_jwt_secret_here_64_characters_minimum

# CORS Allowed Origins (comma-separated list)
# Example: https://authenx.in,https://app.authenx.in
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Database Path (optional, defaults to authenx.db in working directory)
# DB_PATH=/path/to/authenx.db

# Node Environment (development | production)
NODE_ENV=development

# ============================================================================
# HSM (Hardware Security Module) Configuration
# ============================================================================

# HSM Port
HSM_PORT=9099

# HSM Master Key for Envelope Encryption (REQUIRED in production)
# Generate with: openssl rand -hex 32
# This key encrypts all private keys at rest
HSM_MASTER_KEY=your_hsm_master_key_here_64_hex_characters

# ============================================================================
# College Connector Configuration (per connector instance)
# ============================================================================

# College Information
COLLEGE_ID=college-uuid-from-registry
COLLEGE_NAME="College Name"

# Connector Port
PORT=9001

# Database Path
DB_PATH=/path/to/college/erp.db

# Configuration File Path
CONFIG_PATH=/path/to/college/config.json

# Connector Private Key (Ed25519, 64 hex characters)
# Generated during setup - DO NOT share
CONNECTOR_PRIVATE_KEY_HEX=your_connector_private_key_hex

# Shared Secret for HMAC Authentication
# Generated during setup - must match AuthenX server
SHARED_SECRET=your_shared_secret_hex

# HSM Port (for signing operations)
HSM_PORT=9099

# AuthenX Server Origin (for CORS)
AUTHENX_SERVER_ORIGIN=http://localhost:3000

# ============================================================================
# Production Deployment Notes
# ============================================================================

# 1. JWT_SECRET and HSM_MASTER_KEY MUST be set in production
# 2. Use strong, randomly generated secrets (at least 32 bytes / 64 hex chars)
# 3. Store secrets in environment variables or secret management system
# 4. Never commit secrets to version control
# 5. Rotate secrets periodically following security best practices
# 6. Use HTTPS in production (configure reverse proxy for TLS)
# 7. Restrict CORS_ALLOWED_ORIGINS to your actual domains
# 8. Set NODE_ENV=production for production deployments

# ============================================================================
# Security Checklist
# ============================================================================

# [ ] JWT_SECRET set and secured
# [ ] HSM_MASTER_KEY set and secured
# [ ] .env file added to .gitignore
# [ ] CORS origins restricted to actual domains
# [ ] TLS/HTTPS enabled via reverse proxy
# [ ] Database backups configured
# [ ] Audit logs monitored
# [ ] Default passwords changed on first login
# [ ] Firewall rules configured (HSM localhost-only)
# [ ] Rate limiting thresholds reviewed
# [ ] MFA enabled for admin accounts
