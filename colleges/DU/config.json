{
  "college_id": "ddc964ea-96f0-4128-bbf5-1a0c8041df09",
  "college_name": "Delhi University",
  "db_type": "sqlite",
  "db": {
    "path": "./erp.db",
    "table": "student_records",
    "ref_column": "stu_ref"
  },
  "field_mapping": {
    "name": {
      "type": "column",
      "column": "full_name"
    },
    "degree": {
      "type": "column",
      "column": "programme"
    },
    "branch": {
      "type": "column",
      "column": "branch"
    },
    "cgpa": {
      "type": "column",
      "column": "final_cgpa"
    },
    "graduation_year": {
      "type": "column",
      "column": "grad_year"
    },
    "issue_date": {
      "type": "column",
      "column": "issue_dt"
    },
    "credential_type": {
      "type": "direct",
      "value": "DEGREE_CERTIFICATE"
    },
    "status": {
      "type": "map_values",
      "column": "status",
      "active_values": [
        "Active",
        "Alumni",
        "Graduated"
      ],
      "inactive_values": [
        "Withdrawn",
        "Suspended"
      ]
    }
  }
}