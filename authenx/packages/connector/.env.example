# AuthenX Connector — Environment Variables
# This file lives on the college's infrastructure, not on AuthenX cloud.

NODE_ENV=development
CONNECTOR_PORT=3002
CONNECTOR_HOST=0.0.0.0

# Shared secret with AuthenX API (must match API's CONNECTOR_SECRET)
CONNECTOR_SECRET=REPLACE_WITH_SECURE_RANDOM_KEY

# College Ed25519 Private Key (hex-encoded, 64 bytes)
# Generate with: npm run keygen
# NEVER share this. NEVER commit this.
COLLEGE_PRIVATE_KEY=REPLACE_WITH_ED25519_PRIVATE_KEY_HEX
COLLEGE_ISSUER_ID=REPLACE_WITH_COLLEGE_UUID

# Integration mode: 'mock' | 'db' | 'api' | 'view'
INTEGRATION_MODE=mock

# For DB adapter:
ERP_DATABASE_URL=postgresql://readonly_user:password@erp-db-host:5432/erp_db

# For API adapter:
ERP_API_BASE_URL=https://erp.college.edu/api/v1
ERP_API_KEY=REPLACE_WITH_ERP_API_KEY

LOG_LEVEL=debug
