# AuthenX API — Environment Variables
# Copy to .env and fill in your values

NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

DATABASE_URL=postgresql://authenx:authenx_dev_password@localhost:5432/authenx_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_256_BIT_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CONNECTOR_SECRET=REPLACE_WITH_SECURE_RANDOM_KEY
AUTHENX_CODE_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

LOG_LEVEL=debug
