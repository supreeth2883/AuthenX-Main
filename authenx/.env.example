# ═══════════════════════════════════════════════════════════
# AuthenX Root Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════

# ─── Environment ────────────────────────────────────────────
NODE_ENV=development   # development | staging | production

# ─── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql://authenx:authenx_dev_password@localhost:5432/authenx_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT Auth ────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_256_BIT_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── API ─────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3001

# ─── Connector ───────────────────────────────────────────────
CONNECTOR_PORT=3002
CONNECTOR_HOST=0.0.0.0
CONNECTOR_SECRET=REPLACE_WITH_SECURE_RANDOM_KEY  # Shared secret for API->Connector auth

# ─── AuthenX Code Encryption ────────────────────────────────
# AES-256-GCM key for AuthenX Code payload encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTHENX_CODE_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_MAX=100         # max requests per window
RATE_LIMIT_WINDOW_MS=60000 # 1 minute window

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug  # debug | info | warn | error
