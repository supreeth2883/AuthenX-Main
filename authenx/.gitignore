# ─── Environment (NEVER commit) ───────────────────────────────
.env
.env.local
.env.*.local

# ─── Dependencies ─────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Build outputs ────────────────────────────────────────────
dist/
build/
**/dist/
**/build/
*.js.map

# ─── Logs ─────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*

# ─── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editor ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ─── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo

# ─── Keys (CRITICAL: never commit private keys) ───────────────
*.pem
*.key
private_key*
