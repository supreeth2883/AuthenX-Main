{
  "_comment": "AuthenX Connector — MySQL/MariaDB Config Template. Run: npm install mysql2",
  "college_id": "REPLACE_WITH_AUTHENX_COLLEGE_ID",
  "college_name": "Your College Name",
  "port": 9000,
  "db_type": "mysql",
  "db": {
    "host": "127.0.0.1",
    "port": 3306,
    "user": "authenx_readonly",
    "password": "REPLACE_WITH_DB_PASSWORD",
    "database": "college_erp",
    "ssl": false,
    "pool_size": 5,
    "table": "students",
    "ref_column": "student_id"
  },
  "field_mapping": {
    "_comment": "Map your ERP column names to AuthenX standard fields",
    "name": { "type": "column", "column": "full_name" },
    "degree": {
      "type": "transform",
      "source": { "type": "column", "column": "program_name" },
      "ops": ["uppercase", "replace_dots"]
    },
    "branch": { "type": "column", "column": "department_name" },
    "cgpa": { "type": "column", "column": "final_cgpa" },
    "graduation_year": {
      "type": "year_from_date",
      "column": "graduation_date"
    },
    "issue_date": { "type": "column", "column": "certificate_issue_date" },
    "credential_type": { "type": "direct", "value": "DEGREE_CERTIFICATE" },
    "status": {
      "type": "map_values",
      "column": "student_status",
      "active_values": ["active", "alumni", "graduated", "passed", "1"],
      "inactive_values": ["withdrawn", "cancelled", "expelled", "debarred", "0"]
    }
  }
}
