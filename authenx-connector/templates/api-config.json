{
  "_comment": "AuthenX Connector — REST API Config Template. No npm install needed.",
  "college_id": "REPLACE_WITH_AUTHENX_COLLEGE_ID",
  "college_name": "Your College Name",
  "port": 9000,
  "db_type": "api",
  "api": {
    "base_url": "https://erp.yourcollege.edu/api/v1",
    "endpoint": "/students/{ref}",
    "_comment_endpoint": "Use {ref} as placeholder — replaced with student_ref_token at runtime",
    "method": "GET",
    "auth_type": "bearer",
    "_comment_auth": "Supported: bearer | api_key | basic | none",
    "auth_token": "REPLACE_WITH_API_TOKEN",
    "api_key_header": "X-API-Key",
    "health_endpoint": "/health",
    "timeout_ms": 8000
  },
  "field_mapping": {
    "_comment": "Use dot-path notation to access nested API response fields",
    "name": { "type": "nested", "path": "student.full_name" },
    "degree": { "type": "nested", "path": "academics.program" },
    "branch": { "type": "nested", "path": "academics.branch" },
    "cgpa": { "type": "nested", "path": "academics.cgpa" },
    "graduation_year": { "type": "nested", "path": "academics.graduation_year" },
    "issue_date": { "type": "nested", "path": "certificate.issue_date" },
    "credential_type": { "type": "direct", "value": "DEGREE_CERTIFICATE" },
    "status": {
      "type": "map_values",
      "column": "student.status",
      "active_values": ["graduated", "alumni", "active"],
      "inactive_values": ["expelled", "withdrawn", "cancelled"]
    }
  }
}
