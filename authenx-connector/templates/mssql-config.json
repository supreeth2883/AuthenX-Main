{
  "_comment": "AuthenX Connector — SQL Server Config Template. Run: npm install mssql",
  "college_id": "REPLACE_WITH_AUTHENX_COLLEGE_ID",
  "college_name": "Your College Name",
  "port": 9000,
  "db_type": "mssql",
  "db": {
    "host": "localhost",
    "port": 1433,
    "user": "authenx_readonly",
    "password": "REPLACE_WITH_DB_PASSWORD",
    "database": "CollegeERP",
    "schema": "dbo",
    "ssl": true,
    "trust_cert": true,
    "pool_size": 5,
    "table": "StudentMaster",
    "ref_column": "StudentID"
  },
  "field_mapping": {
    "name": {
      "type": "concat",
      "columns": ["FirstName", "MiddleName", "LastName"],
      "separator": " "
    },
    "degree": { "type": "column", "column": "ProgramName" },
    "branch": { "type": "column", "column": "BranchName" },
    "cgpa": { "type": "column", "column": "FinalCGPA" },
    "graduation_year": { "type": "year_from_date", "column": "GraduationDate" },
    "issue_date": { "type": "column", "column": "CertificateIssueDate" },
    "credential_type": { "type": "direct", "value": "DEGREE_CERTIFICATE" },
    "status": {
      "type": "map_values",
      "column": "Status",
      "active_values": ["Graduated", "Alumni", "Active", "1", "true"],
      "inactive_values": ["Expelled", "Withdrawn", "Cancelled", "0", "false"]
    }
  }
}
